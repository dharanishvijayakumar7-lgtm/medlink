rules_version = '2';

// MedLink - Firestore security rules for project medlink-sih, (default) database.
//
// No app reads or writes Firestore directly, so every client request is denied:
//   - the voice agent writes call summaries with the Firebase Admin SDK, and
//   - the MedLink API reads them back for a patient's call history with a
//     service-account key.
// Both use server credentials, which bypass these rules, so denying clients
// changes nothing for either of them. It only shuts out everyone else.
//
// Publish this from the Firebase console (Firestore -> Rules). It replaces the
// rules published earlier, including the copy in the voice agent's repository.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
