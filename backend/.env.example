# Copy to .env and fill in your own values.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/medlink_app

# Reuse the LiveKit project the voice agent already uses.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Reads patient-uploaded medical PDFs. Free tier works; see config.py for
# why these models were chosen.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Translation into Indian languages. User ID and API key (ulcaApiKey) come from
# the Bhashini dashboard (bhashini.gov.in). The pipeline id below is MeitY's
# public one; change it only if Bhashini gave you a different one.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Call history: the voice agent's call summaries are read from Firestore with a
# service-account key file. Point this at the key where it already lives (for
# example the voice agent's own key) - never copy a key into this repository.
# FIREBASE_CREDENTIALS_FILE=C:\path\to\medlink-agent\MEDLINK_FIREBASE_CREDENTIALS.json
